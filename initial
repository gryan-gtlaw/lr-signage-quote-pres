<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>La Riviere Building ID Sign — Quote Comparison</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #B8985A;
    --gold-light: #D4B87A;
    --gold-pale: #F5EDD8;
    --dark: #1A1A18;
    --mid: #3A3A36;
    --muted: #7A7A72;
    --rule: #D8D0BC;
    --bg: #FAFAF7;
    --white: #FFFFFF;
    --green: #2E6B4A;
    --green-pale: #EAF3ED;
    --amber: #8A5E1A;
    --amber-pale: #FBF3E2;
    --red: #8A2E2E;
    --red-pale: #FAE8E8;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--dark);
    font-size: 15px;
    line-height: 1.65;
  }

  /* ── COVER ─────────────────────────────── */
  .cover {
    background: var(--dark);
    color: var(--white);
    padding: 64px 72px 56px;
    position: relative;
    overflow: hidden;
  }
  .cover::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 60px,
      rgba(184,152,90,0.04) 60px,
      rgba(184,152,90,0.04) 61px
    );
  }
  .cover-inner { position: relative; z-index: 1; }
  .cover-label {
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 20px;
    font-weight: 500;
  }
  .cover-title {
    font-family: 'Libre Baskerville', serif;
    font-size: 38px;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 8px;
    letter-spacing: -0.3px;
    font-variant-numeric: lining-nums;
  }
  .cover-title span {
    color: var(--gold-light);
  }
  .cover-sub {
    color: rgba(255,255,255,0.55);
    font-size: 13px;
    font-weight: 300;
    margin-bottom: 40px;
  }
  .cover-meta {
    display: flex;
    gap: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(184,152,90,0.3);
  }
  .cover-meta-item { }
  .cover-meta-label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 4px;
  }
  .cover-meta-value {
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    font-weight: 300;
  }

  /* ── MAIN LAYOUT ────────────────────────── */
  .main { padding: 0 72px 72px; }

  /* ── SECTION HEADS ──────────────────────── */
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 52px 0 24px;
  }
  .section-num {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 2px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .section-title {
    font-family: 'Libre Baskerville', serif;
    font-size: 19px;
    font-weight: 700;
    color: var(--dark);
    font-variant-numeric: lining-nums;
  }
  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
    margin-bottom: 4px;
  }

  /* ── PRICE CARDS ────────────────────────── */
  .price-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 8px;
  }
  .price-card {
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 28px 24px 24px;
    position: relative;
  }
  .price-card.winner {
    border-color: var(--gold);
    background: linear-gradient(135deg, #FFFCF5 0%, #FFF8E8 100%);
  }
  .price-card.winner::before {
    content: 'LOWEST PRICE';
    position: absolute;
    top: -1px; right: 20px;
    background: var(--gold);
    color: var(--white);
    font-size: 8px;
    letter-spacing: 2px;
    padding: 3px 10px;
    font-weight: 500;
  }
  .card-supplier {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .card-name {
    font-family: 'Libre Baskerville', serif;
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--dark);
    font-variant-numeric: lining-nums;
  }
  .card-price {
    font-family: 'Libre Baskerville', serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
    font-variant-numeric: lining-nums;
  }
  .price-card.winner .card-price { color: var(--amber); }
  .card-excl {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .card-divider {
    height: 1px;
    background: var(--rule);
    margin: 16px 0;
  }
  .card-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .card-row strong { color: var(--dark); font-weight: 500; }
  .card-quote-ref {
    font-size: 10px;
    color: var(--muted);
    margin-top: 16px;
    letter-spacing: 0.5px;
  }
  .card-pdf-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 11px;
    font-weight: 500;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.3px;
    border: 1px solid var(--gold);
    padding: 5px 10px;
    border-radius: 2px;
    transition: background 0.15s, color 0.15s;
  }
  .card-pdf-link:hover {
    background: var(--gold);
    color: var(--white);
  }
  .card-pdf-link svg { flex-shrink: 0; }

  .card-contact {
    margin-top: 4px;
  }
  .card-contact-name {
    font-size: 12px;
    font-weight: 500;
    color: var(--dark);
    margin-bottom: 3px;
  }
  .card-contact-detail {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 2px;
  }
  .card-contact-detail a {
    color: var(--muted);
    text-decoration: none;
  }
  .card-contact-detail a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  /* ── SPEC OVERVIEW ──────────────────────── */
  .spec-overview {
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 28px 32px 24px;
  }
  .spec-overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .spec-item {
    display: flex;
    gap: 0;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
  }
  .spec-item:nth-child(odd):last-child,
  .spec-item:nth-last-child(-n+2) {
    border-bottom: none;
  }
  .spec-label {
    width: 140px;
    flex-shrink: 0;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    padding-top: 1px;
    padding-right: 16px;
  }
  .spec-value {
    color: var(--dark);
    font-size: 13px;
    line-height: 1.5;
  }
  .comp-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border: 1px solid var(--rule);
  }
  .comp-table th {
    padding: 12px 16px;
    text-align: left;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    border-bottom: 1px solid var(--rule);
    background: #F7F5F0;
  }
  .comp-table th:first-child { width: 26%; }
  .comp-table th.winner-col { background: #FDF8EE; color: var(--amber); }
  .comp-table td {
    padding: 12px 16px;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
    font-size: 13.5px;
    line-height: 1.55;
  }
  .comp-table tr:last-child td { border-bottom: none; }
  .comp-table td:first-child {
    font-weight: 500;
    color: var(--mid);
    font-size: 11px;
    letter-spacing: 0.3px;
  }
  .comp-table td.winner-col { background: #FFFBF2; }
  .comp-table tr:hover td { background: rgba(0,0,0,0.015); }
  .comp-table tr:hover td.winner-col { background: #FFF8E6; }

  .tick { color: var(--green); font-weight: 500; }
  .cross { color: var(--red); }
  .dash { color: var(--muted); }
  .warn { color: var(--amber); }

  .tag {
    display: inline-block;
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 1px;
    font-weight: 500;
    vertical-align: middle;
    margin-left: 4px;
  }
  .tag-green { background: var(--green-pale); color: var(--green); }
  .tag-amber { background: var(--amber-pale); color: var(--amber); }
  .tag-red { background: var(--red-pale); color: var(--red); }

  /* ── SPEC CHECK TABLE ───────────────────── */
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border: 1px solid var(--rule);
  }
  .spec-table th {
    padding: 10px 14px;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    border-bottom: 1px solid var(--rule);
    background: #F7F5F0;
    text-align: left;
  }
  .spec-table th.center { text-align: center; }
  .spec-table th.winner-col { background: #FDF8EE; color: var(--amber); }
  .spec-table td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    text-align: center;
    vertical-align: middle;
  }
  .spec-table td:first-child {
    text-align: left;
    font-weight: 500;
    color: var(--mid);
    font-size: 11.5px;
  }
  .spec-table tr:last-child td { border-bottom: none; }
  .spec-table td.winner-col { background: #FFFBF2; }
  .spec-icon { font-size: 15px; }

  /* ── ISSUES ──────────────────────────────── */
  .issues-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .issue-card {
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 20px;
  }
  .issue-supplier {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
    font-weight: 500;
  }
  .issue-item {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 1.55;
  }
  .issue-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-top: 5px;
    flex-shrink: 0;
  }
  .issue-dot.red { background: var(--red); }
  .issue-dot.amber { background: var(--amber); }
  .issue-dot.green { background: var(--green); }

  /* ── RECOMMENDATION ─────────────────────── */
  .rec-box {
    background: var(--dark);
    color: var(--white);
    padding: 36px 40px;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
    margin-top: 4px;
  }
  .rec-left { }
  .rec-label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 10px;
    font-weight: 500;
  }
  .rec-supplier {
    font-family: 'Libre Baskerville', serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
    font-variant-numeric: lining-nums;
  }
  .rec-price {
    font-family: 'Libre Baskerville', serif;
    font-size: 32px;
    font-weight: 700;
    color: var(--gold-light);
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .rec-price-sub { font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 4px; }
  .rec-right { }
  .rec-rationale {
    font-size: 14px;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 20px;
    font-weight: 300;
  }
  .rec-points {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .rec-point {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: rgba(255,255,255,0.65);
    line-height: 1.55;
  }
  .rec-point-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    margin-top: 6px;
    flex-shrink: 0;
  }

  /* ── FOOTER ──────────────────────────────── */
  .footer {
    padding: 20px 72px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-left { font-size: 11px; color: var(--muted); }
  .footer-right { font-size: 10px; color: var(--rule); letter-spacing: 1px; }

  @media print {
    .cover { padding: 40px 52px 36px; }
    .main { padding: 0 52px 52px; }
    .footer { padding: 16px 52px; }
    .price-card { break-inside: avoid; }
    .rec-box { break-inside: avoid; }
  }
</style>
</head>
